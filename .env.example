# Copy to .env on the server and change values:
#   cp .env.example .env

MYSQL_ROOT_PASSWORD=change-me-strong-password
DB_NAME=squash_league
DB_USER=root
DB_PASSWORD=change-me-strong-password

# Host port for the front container (nginx on the host proxies here)
FRONT_PORT=3000

# Images from GitHub Container Registry (set by deploy workflow; defaults below)
API_IMAGE=ghcr.io/mikhailprokudin/new-squashleague-api
FRONT_IMAGE=ghcr.io/mikhailprokudin/new-squashleague-front
IMAGE_TAG=latest
